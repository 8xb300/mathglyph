{
  "name": "mathglyph",
  "version": "0.7.0",
  "description": "A tiny text effect: monospace text where letters swap to math glyphs, breathe, and scramble under the pointer.",
  "type": "module",
  "main": "./dist/mathglyph.js",
  "module": "./dist/mathglyph.js",
  "types": "./dist/mathglyph.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mathglyph.d.ts",
      "default": "./dist/mathglyph.js"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "default": "./dist/languages.min.js"
    },
    "./effects/*": {
      "types": "./dist/effects/*.d.ts",
      "default": "./dist/effects/*.min.js"
    },
    "./layouts/*": {
      "types": "./dist/layouts/*.d.ts",
      "default": "./dist/layouts/*.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "text-effect",
    "math",
    "unicode",
    "glyph",
    "animation",
    "canvas",
    "typography",
    "hover",
    "zero-dependencies"
  ],
  "author": "8xb300",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8xb300/mathglyph.git"
  },
  "homepage": "https://8xb300.github.io/mathglyph/",
  "bugs": {
    "url": "https://github.com/8xb300/mathglyph/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
